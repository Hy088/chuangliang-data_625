# 火山方舟 ARK_API_KEY（仅本地代理模式使用，切勿提交到 git）
# 从 https://console.volcengine.com/ark/region:ark+cn-beijing/apikey 获取，形如 ark-xxx（注意：方舟 Key 以 ark- 开头，不是 volc-sk-）
ARK_API_KEY=

# 硅基流动 SiliconFlow 密钥（免费/低成本通道，图片 FLUX/Kolors + 视频 Wan2.2）
# 从 https://siliconflow.cn/ 控制台「API 密钥」获取，形如 sk-xxx
SILICONFLOW_API_KEY=

# PiAPI 密钥（Seedance 2.0 真模型：注册送免费额度，质量远胜 Wan2.2，可进看板）
# 从 https://piapi.ai/ 注册后，「API Key」页面复制 X-API-Key（形如 sk_live_xxx 或 pka_xxx）填这里
PIAPI_API_KEY=

# 即梦AI 官方 API 密钥（火山引擎智能视觉，HMAC 签名；有「免费试用」档，质量=即梦3.0 同源 Seedance 2.0）
# 从火山引擎控制台「访问控制 → 密钥管理」创建 AccessKey/SecretKey（账号需实名认证并开通「即梦AI-视频生成3.0」服务，选免费试用）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
